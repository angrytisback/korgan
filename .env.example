# =============================================================================
# Korgan - environment template. Copy to `.env` and fill in the secrets.
# NEVER commit a real `.env`.
# =============================================================================

# --- Required secrets --------------------------------------------------------
DATABASE_URL=postgres://korgan:korgan_dev_password@localhost:5432/korgan
REDIS_URL=redis://localhost:6379

# Ed25519 signing key (PKCS#8 PEM). Generate with:
#   openssl genpkey -algorithm ed25519
# Store the PEM on ONE line with literal \n separators:
KORGAN__CRYPTO__ED25519_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----

# AES-256-GCM master key for TOTP secrets at rest (32 random bytes, Base64):
#   openssl rand -base64 32
KORGAN__CRYPTO__AES_MASTER_KEY=CHANGE_ME

# --- Pluggable adapters ------------------------------------------------------
# console | smtp | resend | ses      (console is rejected in production)
MAIL_PROVIDER=smtp
# true | false
HIBP_ENABLED=false
# dual | header_only | cookie_only
TOKEN_DELIVERY_MODE=dual

# --- Server ------------------------------------------------------------------
KORGAN__SERVER__HOST=0.0.0.0
KORGAN__SERVER__PORT=8080
KORGAN__SERVER__ENVIRONMENT=development
KORGAN__SERVER__PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated list of exact origins
KORGAN__SERVER__CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Telemetry ---------------------------------------------------------------
# pretty | json
KORGAN__TELEMETRY__LOG_FORMAT=pretty
# RUST_LOG takes precedence over KORGAN__TELEMETRY__LOG_FILTER when set.
# RUST_LOG=info,korgan=debug

# --- Crypto (Argon2id) -------------------------------------------------------
KORGAN__CRYPTO__ARGON2_MEMORY_KIB=19456
KORGAN__CRYPTO__ARGON2_ITERATIONS=2
KORGAN__CRYPTO__ARGON2_PARALLELISM=1

# --- Auth --------------------------------------------------------------------
KORGAN__AUTH__ISSUER=http://localhost:8080
KORGAN__AUTH__AUDIENCE=korgan
KORGAN__AUTH__ACCESS_TOKEN_TTL_SECS=900
KORGAN__AUTH__REFRESH_TOKEN_TTL_SECS=2592000

# --- Mail: SMTP (Mailpit: UI at http://localhost:8025) -----------------------
KORGAN__MAIL__FROM_ADDRESS=no-reply@korgan.local
KORGAN__MAIL__SMTP__HOST=localhost
KORGAN__MAIL__SMTP__PORT=1025
KORGAN__MAIL__SMTP__TLS=none
# KORGAN__MAIL__SMTP__USERNAME=
# KORGAN__MAIL__SMTP__PASSWORD=
# KORGAN__MAIL__RESEND__API_KEY=
# KORGAN__MAIL__SES__REGION=
# KORGAN__MAIL__SES__ACCESS_KEY_ID=
# KORGAN__MAIL__SES__SECRET_ACCESS_KEY=

# --- Rate limiting -----------------------------------------------------------
KORGAN__RATE_LIMIT__ENABLED=true
KORGAN__RATE_LIMIT__WINDOW_SECS=60
KORGAN__RATE_LIMIT__LOGIN_MAX_REQUESTS=10
KORGAN__RATE_LIMIT__TRUST_PROXY_HEADERS=false

# --- docker-compose (used by docker-compose.yml only) ------------------------
POSTGRES_USER=korgan
POSTGRES_PASSWORD=korgan_dev_password
POSTGRES_DB=korgan

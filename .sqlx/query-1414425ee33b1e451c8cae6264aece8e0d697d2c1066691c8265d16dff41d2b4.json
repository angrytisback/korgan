  "query": "\n            SELECT\n                id,\n                user_id,\n                actor_ip,\n                user_agent,\n                request_id,\n                event_type,\n                event_status,\n                metadata,\n                created_at\n            FROM audit_logs\n            WHERE user_id = $1\n            ORDER BY created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
